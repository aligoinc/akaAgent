{
  "name": "@akabiz/engine",
  "version": "0.0.0",
  "description": "Workflow + Block execution engine for akaBiz Auto. Pure TypeScript, browser-agnostic.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  }
}
