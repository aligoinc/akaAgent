{
  "block": {
    "category": "facebook",
    "code": "// Opt-in for comment feeds; the existing find-data branch below stays unchanged.\nif (input.commentFeedSort === true) {\n  const sortType = ['most_relevant', 'new_posts'].includes(vars.commentPostSort)\n    ? vars.commentPostSort : 'recent_activity';\n  const labels = {\n    most_relevant: 'Phù hợp nhất',\n    recent_activity: 'Hoạt động mới đây',\n    new_posts: 'Bài viết mới'\n  };\n  const optionNames = {\n    most_relevant: 'fb_feed_most_relevant_post_option',\n    recent_activity: 'fb_recent_activity_post_btn',\n    new_posts: 'fb_new_post_btn'\n  };\n  const checkAbort = () => {\n    if (signal && signal.aborted) throw new Error('Đã hủy sắp xếp bài viết');\n  };\n  const recordSort = async (status, reason, message, xpath) => {\n    helpers.log(message);\n    await helpers.logRunEvent({\n      eventType: 'sort_posts',\n      eventName: 'Sắp xếp bài viết',\n      targetType: 'feed',\n      status,\n      isUserVisible: false,\n      message,\n      ...(xpath ? { xpath } : {}),\n      debugData: { sortType, reason }\n    });\n    return { postSort: sortType, postSortApplied: status === 'success', postSortReason: reason };\n  };\n  checkAbort();\n  let menuOpened = false;\n  try {\n    const sortButton = await helpers.element('fb_feed_post_sort_button');\n    checkAbort();\n    const button = await page.$(sortButton);\n    checkAbort();\n    if (!button) {\n      return await recordSort('skipped', 'sort_unavailable',\n        'ℹ️ Trang này không có tùy chọn sắp xếp bài viết; giữ thứ tự đang hiển thị.');\n    }\n    await page.click(sortButton);\n    menuOpened = true;\n    await helpers.sleep(1000, signal);\n    checkAbort();\n    const option = await helpers.element(optionNames[sortType]);\n    checkAbort();\n    const available = await page.$(option);\n    checkAbort();\n    if (!available) {\n      await page.press('Escape');\n      menuOpened = false;\n      checkAbort();\n      return await recordSort('skipped', 'option_unavailable',\n        'ℹ️ Trang này không có lựa chọn “' + labels[sortType] + '”; giữ thứ tự đang hiển thị.');\n    }\n    await page.click(option);\n    menuOpened = false;\n    await helpers.sleep(2500, signal);\n    checkAbort();\n    return await recordSort('success', 'selected',\n      'Đã sắp xếp bài viết: ' + labels[sortType] + '.', option);\n  } catch (err) {\n    checkAbort();\n    if (menuOpened) {\n      try { await page.press('Escape'); } catch (_) {}\n      checkAbort();\n    }\n    return await recordSort('failed', 'sort_failed',\n      'Không đổi được sắp xếp bài viết; tiếp tục theo thứ tự đang hiển thị.');\n  }\n}\n\n\nconst needsFeed = vars.isFindInPost === true || vars.isFindInComment === true || vars.isFindPostLink === true || vars.isFindNewInteractors === true;\nif (!needsFeed) {\n  const skippedSort = String(vars.sortTypePost || input.sortTypePost || 'most_relevant');\n  return { postSort: skippedSort, skippedFeed: true };\n}\n\nconst sortType = String(vars.sortTypePost || input.sortTypePost || 'most_relevant');\nif (sortType === 'most_relevant') {\n  await helpers.logRunEvent({\n    eventType: 'sort_posts',\n    eventName: 'Sắp xếp bài viết',\n    targetType: 'feed',\n    status: 'success',\n    isUserVisible: false,\n    message: 'Giữ sắp xếp phù hợp nhất',\n    debugData: { sortType }\n  });\n  return { postSort: sortType };\n}\n\ntry {\n  const sortButton = await helpers.element('fb_most_relevant_btn');\n  if (await page.$(sortButton)) {\n    await page.click(sortButton);\n    await helpers.sleep(1000, signal);\n    const optionName = sortType === 'new_posts' ? 'fb_new_post_btn' : 'fb_recent_activity_post_btn';\n    const option = await helpers.element(optionName);\n    if (await page.$(option)) {\n      await page.click(option);\n      await helpers.sleep(2500, signal);\n      await helpers.logRunEvent({\n        eventType: 'sort_posts',\n        eventName: 'Sắp xếp bài viết',\n        targetType: 'feed',\n        status: 'success',\n        isUserVisible: false,\n        xpath: option,\n        message: 'Đã đổi sắp xếp bài viết',\n        debugData: { sortType, optionName }\n      });\n    }\n  }\n} catch (err) {\n  const message = err && err.message ? err.message : String(err);\n  helpers.log('Không đổi được sắp xếp bài viết: ' + message);\n  await helpers.logRunEvent({\n    eventType: 'sort_posts',\n    eventName: 'Sắp xếp bài viết',\n    targetType: 'feed',\n    status: 'failed',\n    isUserVisible: false,\n    message,\n    debugData: { sortType }\n  });\n}\n\nreturn { postSort: sortType };\n",
    "config_schema": [],
