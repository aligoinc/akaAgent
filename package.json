{
  "name": "aka-biz-auto",
  "version": "3.8.0",
  "description": "Browser Automation Desktop App with Visual Flow Builder",
  "main": "./out/main/index.js",
  "author": "akaBiz",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:server": "electron-vite dev --config electron.server.vite.config.ts --entry out-server/main/index.js",
    "build": "electron-vite build",
    "build:server": "electron-vite build --config electron.server.vite.config.ts",
    "preview": "electron-vite preview",
    "seed:ai:akabizrpa": "node scripts/seed-ai-from-akabizrpa.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "node scripts/build-win.cjs",
    "build:server:win": "node scripts/build-server-win.cjs",
    "test:zalo-origin-policy": "node scripts/run-zalo-server-origin-policy-smoke-test.cjs",
    "test:zalo-ticket-verifier": "node scripts/run-zalo-server-ticket-verifier-smoke-test.cjs",
    "load-test:zalo-gateway": "node scripts/run-zalo-server-gateway-load-test.cjs",
    "build:mac": "npm run build && electron-builder --mac dir --arm64 --config.mac.identity=null --publish never && node scripts/sign-mac-adhoc.cjs dist/mac-arm64/akaBizAuto.app && electron-builder --mac dmg --arm64 --prepackaged dist/mac-arm64 --config.mac.identity=null --config.mac.artifactName='akaAgent.${ext}' --publish never",
    "build:mac:intel": "node scripts/build-mac-intel.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@xyflow/react": "^12.4.4",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.3.1",
    "htmlparser2": "^10.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.55.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "playwright": "^1.58.2",
    "proxy-agent": "^8.0.2",
    "uuid": "^11.1.0",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "zca-js": "^2.1.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "mssql": "^12.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.akabiz.auto",
    "productName": "akaBizAuto",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "version.txt",
        "to": "version.txt"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "files": [
        "out/**/*",
        "!node_modules/**/fsevents{,/**/*}"
      ],
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "shortcutName": "akaBizAuto",
      "artifactName": "akaBizAuto-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  }
}
