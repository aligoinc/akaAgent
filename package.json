{
  "name": "aka-biz-auto",
  "version": "1.7.0",
  "description": "Browser Automation Desktop App with Visual Flow Builder",
  "main": "./out/main/index.js",
  "author": "akaBiz",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "seed:ai:akabizrpa": "node scripts/seed-ai-from-akabizrpa.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac dir --config.mac.identity=null --publish never && node scripts/sign-mac-adhoc.cjs dist/mac-arm64/akaBizAuto.app && electron-builder --mac dmg --prepackaged dist/mac-arm64 --config.mac.identity=null --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.49.1",
    "@xyflow/react": "^12.4.4",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.58.2",
    "uuid": "^11.1.0",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "mssql": "^12.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.akabiz.auto",
    "productName": "akaBizAuto",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "version.txt",
        "to": "version.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "shortcutName": "akaBizAuto",
      "artifactName": "akaBizAuto-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  }
}
