{
  "block": {
    "id": 39,
    "code": "try {\r\n  const btn = await helpers.element('fb_add_friend_button')\r\n  // waitForSelector throws khi timeout → catch ở dưới chỉ catch lỗi engine, không phải timeout\r\n  const found = await page.waitForSelector(btn, { timeout: 5000 }).catch(() => false)\r\n  if (!found) {\r\n    // Không có nút \"Thêm bạn bè\" — tình huống bình thường:\r\n    //   - Đã là bạn (FB hiện \"Bạn bè\" thay vì \"Thêm bạn bè\")\r\n    //   - Đã gửi lời mời, đang chờ phản hồi (FB hiện \"Đã gửi yêu cầu\")\r\n    //   - Profile khoá / FB ẩn nút (privacy settings)\r\n    // → KHÔNG coi là lỗi, return ok: true với cờ alreadyFriend\r\n    helpers.log('ℹ️ Không có nút Thêm bạn bè — bỏ qua (có thể đã là bạn hoặc nút bị ẩn)')\r\n    return { ok: true, clicked: false, alreadyFriend: true }\r\n  }\r\n  await page.click(btn)\r\n  await helpers.sleep(2000, signal)\r\n  return { ok: true, clicked: true, alreadyFriend: false }\r\n} catch (e) {\r\n  return { ok: false, clicked: false, alreadyFriend: false, error: e.message }\r\n}",
    "icon": "UserPlus",
    "kind": "js",
    "name": "fb_add_friend",
    "category": "facebook",
    "staff_id": 1,
    "created_at": "2026-04-26T17:29:28.632356+00:00",
    "is_builtin": true,
    "updated_at": "2026-04-29T10:24:52.401+00:00",
    "description": "Click nút Thêm bạn bè. Nếu không có nút → coi là đã là bạn / FB ẩn nút (KHÔNG lỗi).",
    "system_type": null,
    "config_schema": [],
    "output_schema": [
      {
        "name": "ok",
        "type": "boolean",
        "label": "Có lỗi nghiêm trọng không (false=lỗi, true=OK hoặc skipped)"
      },
      {
        "name": "clicked",
        "type": "boolean",
        "label": "Đã click nút kết bạn chưa"
      },
      {
        "name": "alreadyFriend",
        "type": "boolean",
        "label": "Skip do đã là bạn / nút bị ẩn"
      },
      {
        "name": "error",
